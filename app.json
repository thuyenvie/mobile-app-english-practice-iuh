{
  "expo": {
    "owner": "mobile-app-english-practice-iuh",
    "name": "react-native-practice-template-expo57",
    "slug": "react-native-practice-template-expo57",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "scheme": "com.dohoainho.englishpractice",
    "orientation": "portrait",
    "icon": "./assets/english-practice-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dohoainho.englishpractice",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dohoainho.englishpractice",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/english-practice-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/english-practice-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép ứng dụng chọn ảnh câu hỏi để gia sư AI giải thích.",
          "cameraPermission": "Cho phép ứng dụng chụp ảnh câu hỏi để gia sư AI giải thích."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb2d820e-fed5-4ce3-b1b7-f73c92003d6a"
      }
    }
  }
}
