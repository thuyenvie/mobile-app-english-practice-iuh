# Android Emulator gọi API Gateway trên máy host qua 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:9999/api

# BẮT BUỘC: OAuth Client ID có Application type = Web application.
# Dù đây là app mobile, native SDK dùng Client ID này làm server client/audience
# của ID token. Backend GOOGLE_WEB_CLIENT_ID phải có cùng giá trị.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com

# Chỉ iOS cần truyền Client ID riêng cho native SDK.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-with-ios-client-id.apps.googleusercontent.com

# Tùy chọn trong lúc kiểm tra cấu hình: code sẽ cảnh báo nếu bạn điền cùng một
# giá trị cho WEB và ANDROID. Android Client ID không được gửi lên backend.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace-with-android-client-id.apps.googleusercontent.com

# APK trên điện thoại thật dùng Funnel, cấu hình trong eas.json (preview/apk).
# Giữ URL Emulator ở trên cho .env local; không đổi .env.local qua lại theo thiết bị.
# EAS Update phải dùng environment preview có cùng URL Funnel:
# https://laptop-upv1a8mf.tail0ed20d.ts.net/api
# Hướng dẫn trong repository english-practice-docs:
# https://github.com/thuyenvie/english-practice-docs/blob/main/TAILSCALE_FUNNEL_APK_SETUP.md
